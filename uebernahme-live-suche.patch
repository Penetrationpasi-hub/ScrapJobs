diff --git a/scrapling-server/personio_adapter.py b/scrapling-server/personio_adapter.py
new file mode 100644
index 0000000..fc3bc8e
--- /dev/null
+++ b/scrapling-server/personio_adapter.py
@@ -0,0 +1,58 @@
+"""Personio-Karriereseiten: der öffentliche Stellenfeed `https://<mandant>.jobs.personio.de/xml`.
+
+Gelesen werden nur Titel, Firma (subcompany), Standort, Datum und ID, die Beschreibungen werden verworfen.
+Die Anzeigen-URL ist die öffentliche Seite `https://<mandant>.jobs.personio.de/job/<id>`. Jede Stelle läuft
+durch dieselbe Prüfung wie ein JobPosting (Host, Linkmuster, Titel, Arbeitgeber, Initiativbewerbungen).
+"""
+import json
+import re
+import xml.etree.ElementTree as ET
+
+from extraction import extract, plain
+from safe_http import FetchError
+
+# Ein einzelnes "&" im Text (z. B. "GmbH & Co. KG") ist kein gültiges XML und wird maskiert.
+BARE_AMPERSAND = re.compile(r"&(?!amp;|lt;|gt;|quot;|apos;|#\d+;|#x[0-9a-fA-F]+;)")
+
+
+def positions(text):
+    if re.search(r"<!(?:DOCTYPE|ENTITY)", text, re.I):
+        raise FetchError("unsupported", detail="Feed mit DOCTYPE/ENTITY abgelehnt")
+    try:
+        root = ET.fromstring(BARE_AMPERSAND.sub("&amp;", text.lstrip("﻿")))
+    except ET.ParseError:
+        raise FetchError("unsupported", detail="Personio-Feed nicht lesbar") from None
+    if root.tag != "workzag-jobs":
+        raise FetchError("unsupported", detail="Kein Personio-Feed")
+    rows = []
+    for node in root.findall("position"):
+        def field(name):
+            child = node.find(name)
+            return plain(child.text) if child is not None and child.text else ""
+        offices = [field("office")] + [plain(o.text or "") for o in node.findall("additionalOffices/office")]
+        places = []
+        for place in offices:
+            if place and place not in places:
+                places.append(place)
+        rows.append({"id": field("id"), "title": field("name"), "company": field("subcompany"),
+                     "place": ", ".join(places[:5]), "posted": field("createdAt")})
+    return rows
+
+
+def personio(source, req, get, report):
+    _, text = get(source.api, source, accept_xml=True)
+    host = source.hosts[0]
+    for row in positions(text):
+        if not re.fullmatch(r"\d{1,12}", row["id"]):
+            report["filtered"] += 1
+            continue
+        url = f"https://{host}/job/{row['id']}"
+        data = {"@type": "JobPosting", "title": row["title"], "hiringOrganization": {"name": row["company"]},
+                "url": url, "datePosted": row["posted"],
+                "jobLocation": {"address": {"addressLocality": row["place"]}} if row["place"] else []}
+        safe = json.dumps(data).replace("<", "\\u003c")
+        job = extract('<script type="application/ld+json">' + safe + "</script>", url, source, req.q)
+        if job:
+            yield job
+        else:
+            report["filtered"] += 1
diff --git a/scrapling-server/rems_adapter.py b/scrapling-server/rems_adapter.py
new file mode 100644
index 0000000..9490f97
--- /dev/null
+++ b/scrapling-server/rems_adapter.py
@@ -0,0 +1,54 @@
+"""REMS-Karriereportal: die Stellenliste steht vollständig im HTML der Übersichtsseite.
+
+Gelesen wird nur `recruitment.rems.de/stellenangebote` (Abschnitte DEU/AUT/CHE). Die Einzelseiten haben keine
+strukturierten Daten und werden nicht abgerufen. Der Arbeitgeber gilt nur als belegt, wenn der Seitentitel
+"REMS Recruitment-Portal" lautet; jede Stelle läuft durch die übliche Prüfung (Host, Linkmuster, Titel, Datum).
+"""
+import json
+import re
+from urllib.parse import urljoin
+
+from scrapling import Selector
+
+from extraction import extract, plain
+from safe_http import FetchError
+
+COUNTRIES = ("DEU", "AUT", "CHE")
+PRELINE = re.compile(r"^\s*([A-Z]{3})\s*-\s*(\d{2})\.(\d{2})\.(\d{4})\s*$")
+
+
+def listing(html, base):
+    if not re.search(r"<title>\s*REMS\s+Recruitment-Portal\s*</title>", html, re.I):
+        raise FetchError("unsupported", detail="Seitentitel nicht 'REMS Recruitment-Portal'")
+    page = Selector(html)
+    rows = []
+    for code in COUNTRIES:
+        for entry in page.css(f"div#{code} div.jobentry"):
+            link = entry.css("h2 a")
+            if len(link) != 1:
+                rows.append(None)
+                continue
+            place = plain(" ".join(entry.css("h3").getall()))
+            place = re.sub(r"^\s*Standort\s+", "", place)
+            stamp = PRELINE.match(plain(" ".join(entry.css(".jobentrypreline").getall())))
+            posted = f"{stamp.group(4)}-{stamp.group(3)}-{stamp.group(2)}" if stamp and stamp.group(1) == code else ""
+            rows.append({"title": plain(link[0].get()), "url": urljoin(base, link[0].attrib.get("href", "")),
+                         "place": place + ("" if code == "DEU" or not place else f", {code}"), "posted": posted})
+    return rows
+
+
+def rems_list(source, req, get, report):
+    final, html = get(source.search, source)
+    for row in listing(html, final):
+        if not row or not row["title"]:
+            report["filtered"] += 1
+            continue
+        data = {"@type": "JobPosting", "title": row["title"], "hiringOrganization": {"name": "REMS"},
+                "url": row["url"], "datePosted": row["posted"],
+                "jobLocation": {"address": {"addressLocality": row["place"]}} if row["place"] else []}
+        safe = json.dumps(data).replace("<", "\\u003c")
+        job = extract('<script type="application/ld+json">' + safe + "</script>", row["url"], source, req.q)
+        if job:
+            yield job
+        else:
+            report["filtered"] += 1
